# =============================================================================
# SAP BTP CREDENTIALS - COPY THIS FILE TO terraform.tfvars
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file:  cp terraform.tfvars.example terraform.tfvars
# 2. Fill in YOUR values below
# 3. Never commit terraform.tfvars to git (it's in .gitignore)
#
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Your SAP BTP Global Account Subdomain
# -----------------------------------------------------------------------------
# Where to find it:
#   1. Log into SAP BTP Cockpit: https://cockpit.btp.cloud.sap
#   2. Look at the URL or the "Subdomain" field in your Global Account
#   3. For trial accounts, it looks like: "12345678trial-ga"
#   4. For enterprise accounts, it's your custom subdomain
#
globalaccount_subdomain = "your-globalaccount-subdomain"

# -----------------------------------------------------------------------------
# REQUIRED: Your SAP BTP Login Credentials
# -----------------------------------------------------------------------------
# Use the same email and password you use to log into SAP BTP Cockpit
#
btp_username = "your.email@company.com"
btp_password = "your-password-here"

# -----------------------------------------------------------------------------
# OPTIONAL: SAP BTP Region (default: us10)
# -----------------------------------------------------------------------------
# Available regions depend on your account type:
#
# Trial Account Regions:
#   - us10 (US East - Virginia)
#   - eu10 (Europe - Frankfurt)
#   - ap21 (Asia Pacific - Singapore)
#
# Enterprise Account Regions (examples):
#   - us10, us20, us21, us30
#   - eu10, eu11, eu20, eu30
#   - ap10, ap11, ap12, ap20, ap21
#   - jp10, jp20
#   - br10
#
# Check your available regions in BTP Cockpit under "Regions"
#
region = "us10"
