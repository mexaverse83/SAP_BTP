# =============================================================================
# CUSTOMER CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to create a new customer:
#   cp customer.tfvars.example acme.tfvars
#
# Then deploy with:
#   terraform apply -var-file="customers/acme.tfvars"
# =============================================================================

customer_name = "ACME Corp"
customer_id   = "acme"      # lowercase, hyphens only — used in subdomain

# Override region for this customer (default: us10)
# region = "eu10"

# Additional services beyond the base (destination, xsuaa, html5-apps-repo).
# See variables.tf for the full catalog.
#
# Example for a manufacturing company:
# additional_services = ["integration_suite", "analytics_cloud", "connectivity"]
additional_services = []
