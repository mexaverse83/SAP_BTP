# =============================================================================
# CUSTOMER CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to create a new customer:
#   cp customer.tfvars.example acme.tfvars
#
# Then deploy with:
#   terraform apply -var-file="customers/acme.tfvars"
#
# =============================================================================

# Customer Details
customer_name = "ACME Corp"
customer_id   = "acme"      # lowercase, no spaces - used in subdomain

# Optional: Override region for this customer (default: us10)
# region = "eu10"

# -----------------------------------------------------------------------------
# Additional Services
# -----------------------------------------------------------------------------
# Add any services this customer needs (beyond the base services).
# Base services (always included): destination, xsuaa, html5-apps-repo
#
# Available options:
#   - "cf_runtime"    : Cloud Foundry runtime
#   - "hana_cloud"    : SAP HANA Cloud (enterprise only)
#   - "connectivity"  : On-premise connectivity
#   - "bas"           : Business Application Studio (enterprise only)
#   - "workzone"      : SAP Build Work Zone (enterprise only)
#   - "aicore"        : SAP AI Core (enterprise only)
#
# Example:
# additional_services = ["cf_runtime", "connectivity"]
additional_services = []
